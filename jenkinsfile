pipeline {

    agent any

    environment {

        // =====================================================
        // AWS CONFIGURATION
        // =====================================================

        AWS_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = '847547470089'

        // =====================================================
        // ECR CONFIGURATION
        // Existing image - DO NOT BUILD / TAG / PUSH
        // =====================================================

        ECR_REPOSITORY = 'devops-ecr'

        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

        IMAGE_NAME = "${ECR_REGISTRY}/${ECR_REPOSITORY}"

        IMAGE_TAG = 'v1'

        // =====================================================
        // EKS CONFIGURATION
        // =====================================================

        EKS_CLUSTER = 'devops-eks'

        // =====================================================
        // JENKINS AWS CREDENTIAL
        // =====================================================

        AWS_CREDENTIAL_ID = 'aws-credentials'

        // =====================================================
        // SONARQUBE
        // Jenkins:
        // Manage Jenkins → System → SonarQube installations
        // =====================================================

        SONARQUBE_SERVER = 'SonarQube'
    }


    stages {

        // =====================================================
        // 1. CHECKOUT
        // =====================================================

        stage('Checkout') {

            steps {

                echo 'Checking out code from GitHub...'

                git(
                    branch: 'main',
                    url: 'https://github.com/Vijaykumar-03/Flipkart.git'
                )

                sh '''
                    set -e

                    echo "=========================================="
                    echo "REPOSITORY"
                    echo "=========================================="

                    pwd

                    ls -la

                    echo "=========================================="
                    echo "GIT COMMIT"
                    echo "=========================================="

                    git log -1 --oneline

                    echo "=========================================="
                    echo "FILES"
                    echo "=========================================="

                    find . -maxdepth 3 -type f \
                        -not -path './.git/*' \
                        -not -path './venv/*'
                '''
            }
        }


        // =====================================================
        // 2. LINT
        // =====================================================

        stage('Lint') {

            steps {

                echo 'Running Python lint...'

                sh '''
                    set -e

                    echo "=========================================="
                    echo "PYTHON VERSION"
                    echo "=========================================="

                    python3 --version

                    echo "=========================================="
                    echo "CHECKING FLAKE8"
                    echo "=========================================="

                    if command -v flake8 >/dev/null 2>&1; then

                        echo "Flake8 already installed."

                    else

                        echo "Installing Flake8..."

                        python3 -m pip install \
                            --break-system-packages \
                            flake8

                    fi

                    echo "=========================================="
                    echo "RUNNING FLAKE8"
                    echo "=========================================="

                    flake8 . \
                        --exclude=venv,.git \
                        --ignore=E501,W503 \
                        || true

                    echo "=========================================="
                    echo "LINT COMPLETED"
                    echo "=========================================="
                '''
            }
        }


        // =====================================================
        // 3. UNIT TEST
        // =====================================================

        stage('Unit Test') {

            steps {

                echo 'Running unit tests...'

                sh '''
                    set -e

                    echo "=========================================="
                    echo "CHECKING TESTS"
                    echo "=========================================="

                    if [ -d tests ]; then

                        echo "Tests directory found."

                        if command -v pytest >/dev/null 2>&1; then

                            echo "Pytest already installed."

                        else

                            echo "Installing Pytest..."

                            python3 -m pip install \
                                --break-system-packages \
                                pytest

                        fi

                        echo "=========================================="
                        echo "RUNNING PYTEST"
                        echo "=========================================="

                        pytest -v

                    else

                        echo "No tests directory found."
                        echo "Skipping unit tests."

                    fi

                    echo "=========================================="
                    echo "UNIT TEST COMPLETED"
                    echo "=========================================="
                '''
            }
        }


        // =====================================================
        // 4. SONARQUBE
        // =====================================================

        stage('SonarQube Analysis') {

            steps {

                echo 'Running SonarQube analysis...'

                withSonarQubeEnv("${SONARQUBE_SERVER}") {

                    sh '''
                        set -e

                        echo "=========================================="
                        echo "SONARQUBE ANALYSIS"
                        echo "=========================================="

                        if ! command -v sonar-scanner >/dev/null 2>&1; then

                            echo "ERROR: sonar-scanner is not installed."

                            exit 1

                        fi

                        sonar-scanner \
                            -Dsonar.projectKey=flipkart \
                            -Dsonar.projectName=Flipkart \
                            -Dsonar.sources=. \
                            -Dsonar.exclusions=venv/**,.git/**

                        echo "=========================================="
                        echo "SONARQUBE ANALYSIS COMPLETED"
                        echo "=========================================="
                    '''
                }
            }
        }


        // =====================================================
        // 5. TRIVY FILESYSTEM SCAN
        // =====================================================

        stage('Trivy Filesystem Scan') {

            steps {

                echo 'Running Trivy filesystem scan...'

                sh '''
                    set -e

                    echo "=========================================="
                    echo "TRIVY VERSION"
                    echo "=========================================="

                    trivy --version

                    echo "=========================================="
                    echo "CHECKING TRIVY CONFIG"
                    echo "=========================================="

                    if [ ! -f trivy.yaml ]; then

                        echo "ERROR: trivy.yaml not found."

                        exit 1

                    fi

                    echo "=========================================="
                    echo "TRIVY FILESYSTEM SCAN"
                    echo "=========================================="

                    trivy \
                        --config ./trivy.yaml \
                        fs . \
                        --severity HIGH,CRITICAL \
                        --ignore-unfixed

                    echo "=========================================="
                    echo "TRIVY FILESYSTEM SCAN COMPLETED"
                    echo "=========================================="
                '''
            }
        }


        // =====================================================
        // 6. AWS AUTHENTICATION
        // =====================================================

        stage('AWS Authentication') {

            steps {

                echo 'Authenticating with AWS...'

                withCredentials([
                    usernamePassword(
                        credentialsId: "${AWS_CREDENTIAL_ID}",
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "=========================================="
                        echo "AWS CLI"
                        echo "=========================================="

                        aws --version

                        echo "=========================================="
                        echo "AWS IDENTITY"
                        echo "=========================================="

                        aws sts get-caller-identity

                        echo "=========================================="
                        echo "AWS AUTHENTICATION SUCCESSFUL"
                        echo "=========================================="
                    '''
                }
            }
        }


        // =====================================================
        // 7. CONNECT TO EKS
        // =====================================================

        stage('Connect to EKS') {

            steps {

                echo 'Connecting to EKS...'

                withCredentials([
                    usernamePassword(
                        credentialsId: "${AWS_CREDENTIAL_ID}",
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "=========================================="
                        echo "UPDATING KUBECONFIG"
                        echo "=========================================="

                        aws eks update-kubeconfig \
                            --region "${AWS_REGION}" \
                            --name "${EKS_CLUSTER}"

                        echo "=========================================="
                        echo "KUBECTL VERSION"
                        echo "=========================================="

                        kubectl version --client

                        echo "=========================================="
                        echo "EKS CLUSTER"
                        echo "=========================================="

                        kubectl cluster-info

                        echo "=========================================="
                        echo "EKS NODES"
                        echo "=========================================="

                        kubectl get nodes
                    '''
                }
            }
        }


        // =====================================================
        // 8. DEPLOY TO EKS
        // Deployment + Service + Ingress
        // =====================================================

        stage('Deploy to EKS') {

            steps {

                echo 'Deploying application to EKS using Ingress...'

                withCredentials([
                    usernamePassword(
                        credentialsId: "${AWS_CREDENTIAL_ID}",
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "=========================================="
                        echo "CHECKING KUBERNETES FILES"
                        echo "=========================================="

                        if [ ! -f k8s/deployment.yml ]; then

                            echo "ERROR: k8s/deployment.yml not found."

                            exit 1

                        fi

                        if [ ! -f k8s/service.yml ]; then

                            echo "ERROR: k8s/service.yml not found."

                            exit 1

                        fi

                        if [ ! -f k8s/ingress.yml ]; then

                            echo "ERROR: k8s/ingress.yml not found."

                            exit 1

                        fi


                        echo "=========================================="
                        echo "KUBERNETES FILES"
                        echo "=========================================="

                        ls -la k8s/


                        echo "=========================================="
                        echo "EXISTING ECR IMAGE"
                        echo "=========================================="

                        echo "${IMAGE_NAME}:${IMAGE_TAG}"


                        echo "=========================================="
                        echo "UPDATING DEPLOYMENT IMAGE"
                        echo "=========================================="

                        sed -i \
                            "s|image:.*|image: ${IMAGE_NAME}:${IMAGE_TAG}|g" \
                            k8s/deployment.yml

                        echo "Deployment image:"

                        grep "image:" k8s/deployment.yml


                        echo "=========================================="
                        echo "VALIDATING DEPLOYMENT"
                        echo "=========================================="

                        kubectl apply \
                            --dry-run=client \
                            -f k8s/deployment.yml


                        echo "=========================================="
                        echo "VALIDATING SERVICE"
                        echo "=========================================="

                        kubectl apply \
                            --dry-run=client \
                            -f k8s/service.yml


                        echo "=========================================="
                        echo "VALIDATING INGRESS"
                        echo "=========================================="

                        kubectl apply \
                            --dry-run=client \
                            -f k8s/ingress.yml


                        echo "=========================================="
                        echo "APPLYING DEPLOYMENT"
                        echo "=========================================="

                        kubectl apply \
                            -f k8s/deployment.yml


                        echo "=========================================="
                        echo "APPLYING SERVICE"
                        echo "=========================================="

                        kubectl apply \
                            -f k8s/service.yml


                        echo "=========================================="
                        echo "APPLYING INGRESS"
                        echo "=========================================="

                        kubectl apply \
                            -f k8s/ingress.yml


                        echo "=========================================="
                        echo "WAITING FOR DEPLOYMENT"
                        echo "=========================================="

                        kubectl rollout status deployment --timeout=180s


                        echo "=========================================="
                        echo "DEPLOYMENTS"
                        echo "=========================================="

                        kubectl get deployments


                        echo "=========================================="
                        echo "PODS"
                        echo "=========================================="

                        kubectl get pods -o wide


                        echo "=========================================="
                        echo "SERVICES"
                        echo "=========================================="

                        kubectl get services


                        echo "=========================================="
                        echo "INGRESS"
                        echo "=========================================="

                        kubectl get ingress


                        echo "=========================================="
                        echo "EKS DEPLOYMENT COMPLETED"
                        echo "=========================================="
                    '''
                }
            }
        }
    }


    // =========================================================
    // POST ACTIONS
    // =========================================================

    post {

        success {

            echo """
==========================================
        PIPELINE SUCCESS
==========================================

Build Number:
${BUILD_NUMBER}

Existing Docker Image:
${IMAGE_NAME}:${IMAGE_TAG}

EKS Cluster:
${EKS_CLUSTER}

AWS Region:
${AWS_REGION}

Kubernetes:
Deployment + Service + Ingress

==========================================
"""
        }


        failure {

            echo """
==========================================
        PIPELINE FAILED
==========================================

Build Number:
${BUILD_NUMBER}

Check the FIRST failed stage above.

==========================================
"""
        }


        always {

            cleanWs()
        }
    }
}

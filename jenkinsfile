pipeline {

    agent any

    options {
        timestamps()
        timeout(time: 45, unit: 'MINUTES')
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    environment {

        // ==============================
        // GIT
        // ==============================
        GIT_REPO   = 'https://github.com/Vijaykumar-03/Flipkart.git'
        GIT_BRANCH = 'main'

        // ==============================
        // AWS
        // ==============================
        AWS_REGION     = 'ap-south-1'
        AWS_ACCOUNT_ID = '847547470089'

        // ECR repository
        ECR_REPOSITORY = 'devops-ecr'

        // Required tag
        IMAGE_TAG = 'v1'

        // Complete image name
        ECR_IMAGE = '847547470089.dkr.ecr.ap-south-1.amazonaws.com/devops-ecr:v1'

        // ==============================
        // EKS
        // ==============================
        EKS_CLUSTER_NAME = 'devops-eks'
        VPC_ID            = 'vpc-06219807031b348d2'
        K8S_NAMESPACE     = 'default'

        // ==============================
        // AWS LOAD BALANCER CONTROLLER
        // ==============================
        LBC_NAMESPACE       = 'kube-system'
        LBC_SERVICE_ACCOUNT = 'aws-load-balancer-controller'

        LBC_POLICY_ARN =
            'arn:aws:iam::847547470089:policy/AWSLoadBalancerControllerIAMPolicy'

        // ==============================
        // SONARQUBE
        // ==============================
        SONAR_SERVER_NAME  = 'SonarQube'
        SONAR_PROJECT_KEY  = 'flipkart'
        SONAR_PROJECT_NAME = 'Flipkart'

        // ==============================
        // JENKINS CREDENTIALS
        // ==============================
        AWS_CREDENTIALS_ID   = 'aws-credentials'
        SONAR_CREDENTIALS_ID = 'sonarqube-token'
    }


    stages {

        // =========================================================
        // 1. CHECKOUT
        // =========================================================

        stage('Checkout') {

            steps {

                echo '=========================================='
                echo 'CHECKING OUT SOURCE CODE'
                echo '=========================================='

                deleteDir()

                git(
                    branch: "${GIT_BRANCH}",
                    url: "${GIT_REPO}"
                )

                echo 'Checkout completed.'
            }
        }


        // =========================================================
        // 2. CHECK REQUIRED TOOLS
        // =========================================================

        stage('Check Required Tools') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "CHECKING REQUIRED TOOLS"
                    echo "=========================================="

                    echo ""
                    echo "Java:"
                    java -version

                    echo ""
                    echo "Python:"
                    python3 --version

                    echo ""
                    echo "AWS:"
                    aws --version

                    echo ""
                    echo "Kubectl:"
                    kubectl version --client

                    echo ""
                    echo "Helm:"
                    helm version --short

                    echo ""
                    echo "eksctl:"
                    eksctl version

                    echo ""
                    echo "Docker:"
                    docker --version

                    echo ""
                    echo "Trivy:"
                    trivy --version

                    echo ""
                    echo "curl:"
                    curl --version | head -1

                    echo ""
                    echo "All required tools are available."
                '''
            }
        }


        // =========================================================
        // 3. PYTHON ENVIRONMENT
        // =========================================================

        stage('Python Environment') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "PYTHON ENVIRONMENT"
                    echo "=========================================="

                    rm -rf .venv

                    python3 -m venv .venv

                    . .venv/bin/activate

                    python --version
                    pip --version
                '''
            }
        }


        // =========================================================
        // 4. PYTHON DEPENDENCIES
        // =========================================================

        stage('Install Python Dependencies') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "PYTHON DEPENDENCIES"
                    echo "=========================================="

                    . .venv/bin/activate

                    python -m pip install --upgrade pip

                    if [ -f requirements.txt ]; then

                        pip install -r requirements.txt

                    else

                        echo "WARNING: requirements.txt not found."
                        echo "Skipping dependency installation."

                    fi
                '''
            }
        }


        // =========================================================
        // 5. LINT
        // =========================================================

        stage('Lint') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "LINT"
                    echo "=========================================="

                    . .venv/bin/activate

                    pip install flake8

                    flake8 . \
                        --exclude=.venv,venv,env,.git,__pycache__,.pytest_cache \
                        --max-line-length=88
                '''
            }
        }


        // =========================================================
        // 6. UNIT TEST
        // =========================================================

        stage('Unit Test') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "UNIT TEST"
                    echo "=========================================="

                    . .venv/bin/activate

                    if [ -d tests ]; then

                        pip install pytest

                        pytest -v

                    else

                        echo "WARNING: tests directory not found."
                        echo "Skipping unit tests."

                    fi
                '''
            }
        }


        // =========================================================
        // 7. SONARQUBE ANALYSIS
        // =========================================================

        stage('SonarQube Analysis') {

            steps {

                script {

                    echo '=========================================='
                    echo 'SONARQUBE ANALYSIS'
                    echo '=========================================='

                    def scannerHome = tool(
                        name: 'SonarScanner',
                        type: 'hudson.plugins.sonar.SonarRunnerInstallation'
                    )

                    withSonarQubeEnv("${SONAR_SERVER_NAME}") {

                        withCredentials([
                            string(
                                credentialsId: "${SONAR_CREDENTIALS_ID}",
                                variable: 'SONAR_TOKEN'
                            )
                        ]) {

                            sh """
                                set -e

                                echo "=========================================="
                                echo "SONAR SCANNER VERSION"
                                echo "=========================================="

                                "${scannerHome}/bin/sonar-scanner" --version

                                echo ""
                                echo "=========================================="
                                echo "RUNNING SONARQUBE ANALYSIS"
                                echo "=========================================="

                                "${scannerHome}/bin/sonar-scanner" \
                                    -Dsonar.projectKey="${SONAR_PROJECT_KEY}" \
                                    -Dsonar.projectName="${SONAR_PROJECT_NAME}" \
                                    -Dsonar.sources=. \
                                    -Dsonar.token="\\${SONAR_TOKEN}" \
                                    -Dsonar.exclusions=".venv/**,venv/**,env/**,.git/**,__pycache__/**,tests/**"

                                echo ""
                                echo "SonarQube analysis completed."
                            """
                        }
                    }
                }
            }
        }


        // =========================================================
        // 8. SONARQUBE QUALITY GATE
        // =========================================================

        stage('SonarQube Quality Gate') {

            steps {

                script {

                    echo '=========================================='
                    echo 'SONARQUBE QUALITY GATE'
                    echo '=========================================='

                    timeout(time: 5, unit: 'MINUTES') {

                        waitForQualityGate(
                            abortPipeline: true
                        )
                    }

                    echo "Quality Gate passed."
                }
            }
        }


        // =========================================================
        // 9. TRIVY FILESYSTEM SCAN
        // =========================================================

        stage('Trivy Filesystem Scan') {

            steps {

                sh '''
                    set +e

                    echo "=========================================="
                    echo "TRIVY FILESYSTEM SCAN"
                    echo "=========================================="

                    trivy fs \
                        --severity HIGH,CRITICAL \
                        --exit-code 0 \
                        --scanners vuln,secret,misconfig \
                        .

                    echo ""
                    echo "Filesystem scan completed."

                    exit 0
                '''
            }
        }


        // =========================================================
        // 10. BUILD AND PUSH DOCKER IMAGE
        // =========================================================

        stage('Build and Push Docker Image') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: "${AWS_CREDENTIALS_ID}",
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {

                    sh '''
                        set -e

                        export AWS_DEFAULT_REGION="${AWS_REGION}"

                        echo "=========================================="
                        echo "AWS IDENTITY"
                        echo "=========================================="

                        aws sts get-caller-identity

                        echo ""
                        echo "=========================================="
                        echo "CHECKING DOCKER"
                        echo "=========================================="

                        docker version

                        echo ""
                        echo "Docker access is working."

                        echo ""
                        echo "=========================================="
                        echo "ECR LOGIN"
                        echo "=========================================="

                        aws ecr get-login-password \
                            --region "${AWS_REGION}" | \
                        docker login \
                            --username AWS \
                            --password-stdin \
                            "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

                        echo ""
                        echo "ECR login successful."

                        echo ""
                        echo "=========================================="
                        echo "CHECKING ECR REPOSITORY"
                        echo "=========================================="

                        aws ecr describe-repositories \
                            --repository-names "${ECR_REPOSITORY}" \
                            --region "${AWS_REGION}" \
                            >/dev/null

                        echo "ECR repository exists: ${ECR_REPOSITORY}"

                        echo ""
                        echo "=========================================="
                        echo "BUILDING DOCKER IMAGE"
                        echo "=========================================="

                        echo "Image:"
                        echo "${ECR_IMAGE}"

                        docker build \
                            -t "${ECR_IMAGE}" \
                            .

                        echo ""
                        echo "Docker image built successfully."

                        echo ""
                        echo "=========================================="
                        echo "PUSHING IMAGE TO ECR"
                        echo "=========================================="

                        docker push "${ECR_IMAGE}"

                        echo ""
                        echo "Image pushed successfully."

                        echo ""
                        echo "=========================================="
                        echo "VERIFYING ECR IMAGE"
                        echo "=========================================="

                        aws ecr describe-images \
                            --repository-name "${ECR_REPOSITORY}" \
                            --region "${AWS_REGION}" \
                            --image-ids imageTag="${IMAGE_TAG}"

                        echo ""
                        echo "ECR image ${IMAGE_TAG} verified successfully."
                    '''
                }
            }
        }


        // =========================================================
        // 11. TRIVY ECR IMAGE SCAN
        // =========================================================

        stage('Trivy ECR Image Scan') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: "${AWS_CREDENTIALS_ID}",
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {

                    sh '''
                        set -e

                        export AWS_DEFAULT_REGION="${AWS_REGION}"

                        echo "=========================================="
                        echo "AWS IDENTITY"
                        echo "=========================================="

                        aws sts get-caller-identity

                        echo ""
                        echo "=========================================="
                        echo "DOCKER ACCESS"
                        echo "=========================================="

                        docker ps

                        echo ""
                        echo "=========================================="
                        echo "ECR LOGIN"
                        echo "=========================================="

                        aws ecr get-login-password \
                            --region "${AWS_REGION}" | \
                        docker login \
                            --username AWS \
                            --password-stdin \
                            "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

                        echo ""
                        echo "ECR login successful."

                        echo ""
                        echo "=========================================="
                        echo "VERIFYING ECR IMAGE"
                        echo "=========================================="

                        aws ecr describe-images \
                            --repository-name "${ECR_REPOSITORY}" \
                            --region "${AWS_REGION}" \
                            --image-ids imageTag="${IMAGE_TAG}"

                        echo ""
                        echo "=========================================="
                        echo "TRIVY ECR IMAGE SCAN"
                        echo "=========================================="

                        echo "Image:"
                        echo "${ECR_IMAGE}"

                        trivy image \
                            --severity HIGH,CRITICAL \
                            --exit-code 0 \
                            "${ECR_IMAGE}"

                        echo ""
                        echo "ECR image scan completed successfully."
                    '''
                }
            }
        }


        // =========================================================
        // 12. KUBERNETES DEPLOYMENT
        // =========================================================

        stage('Kubernetes Deployment') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: "${AWS_CREDENTIALS_ID}",
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {

                    sh '''
                        set -e

                        export AWS_DEFAULT_REGION="${AWS_REGION}"

                        echo "=========================================="
                        echo "AWS IDENTITY"
                        echo "=========================================="

                        aws sts get-caller-identity


                        # ================================================
                        # KUBECONFIG
                        # ================================================

                        echo "=========================================="
                        echo "CONFIGURING KUBECONFIG"
                        echo "=========================================="

                        rm -rf "${WORKSPACE}/.kube"

                        mkdir -p "${WORKSPACE}/.kube"

                        export KUBECONFIG="${WORKSPACE}/.kube/config"

                        aws eks update-kubeconfig \
                            --region "${AWS_REGION}" \
                            --name "${EKS_CLUSTER_NAME}" \
                            --kubeconfig "${KUBECONFIG}"

                        echo ""
                        echo "Current context:"

                        kubectl config current-context


                        # ================================================
                        # EKS CONNECTION
                        # ================================================

                        echo ""
                        echo "=========================================="
                        echo "VERIFYING EKS CONNECTION"
                        echo "=========================================="

                        kubectl --request-timeout=30s get nodes -o wide


                        # ================================================
                        # OIDC
                        # ================================================

                        echo ""
                        echo "=========================================="
                        echo "CHECKING EKS OIDC"
                        echo "=========================================="

                        OIDC_ISSUER=$(aws eks describe-cluster \
                            --region "${AWS_REGION}" \
                            --name "${EKS_CLUSTER_NAME}" \
                            --query 'cluster.identity.oidc.issuer' \
                            --output text)

                        echo "OIDC:"
                        echo "${OIDC_ISSUER}"

                        if [ -z "${OIDC_ISSUER}" ] || [ "${OIDC_ISSUER}" = "None" ]; then

                            echo "ERROR: OIDC issuer not found."

                            exit 1

                        fi


                        # ================================================
                        # IAM POLICY
                        # ================================================

                        echo ""
                        echo "=========================================="
                        echo "CHECKING LOAD BALANCER IAM POLICY"
                        echo "=========================================="

                        aws iam get-policy \
                            --policy-arn "${LBC_POLICY_ARN}" \
                            >/dev/null

                        echo "IAM policy exists."


                        # ================================================
                        # FIND EXISTING IAM ROLE
                        # ================================================

                        echo ""
                        echo "=========================================="
                        echo "DISCOVERING IAM ROLE"
                        echo "=========================================="

                        ROLE_ARN=$(kubectl get serviceaccount \
                            "${LBC_SERVICE_ACCOUNT}" \
                            -n "${LBC_NAMESPACE}" \
                            -o jsonpath='{.metadata.annotations.eks\\.amazonaws\\.com/role-arn}' \
                            2>/dev/null || true)


                        if [ -z "${ROLE_ARN}" ]; then

                            ROLE_ARN=$(eksctl get iamserviceaccount \
                                --cluster="${EKS_CLUSTER_NAME}" \
                                --region="${AWS_REGION}" \
                                -o json 2>/dev/null | \
                                python3 -c '
import sys
import json

try:
    data = json.load(sys.stdin)

    if isinstance(data, list):

        for item in data:

            metadata = item.get("metadata", {})
            status = item.get("status", {})

            if (
                metadata.get("namespace") == "kube-system"
                and
                metadata.get("name") == "aws-load-balancer-controller"
            ):

                print(status.get("roleARN", ""))
                break

except Exception:
    pass
' || true)

                        fi


                        if [ -z "${ROLE_ARN}" ]; then

                            echo "ERROR: IAM role not found."

                            eksctl get iamserviceaccount \
                                --cluster="${EKS_CLUSTER_NAME}" \
                                --region="${AWS_REGION}" || true

                            exit 1

                        fi


                        echo "IAM Role:"
                        echo "${ROLE_ARN}"


                        # ================================================
                        # SERVICE ACCOUNT
                        # ================================================

                        echo ""
                        echo "=========================================="
                        echo "CHECKING SERVICE ACCOUNT"
                        echo "=========================================="

                        if ! kubectl get serviceaccount \
                            "${LBC_SERVICE_ACCOUNT}" \
                            -n "${LBC_NAMESPACE}" \
                            >/dev/null 2>&1
                        then

                            echo "ServiceAccount does not exist."

                            echo "Creating ServiceAccount..."

                            kubectl create serviceaccount \
                                "${LBC_SERVICE_ACCOUNT}" \
                                -n "${LBC_NAMESPACE}"

                        else

                            echo "ServiceAccount exists."

                        fi


                        # ================================================
                        # IRSA
                        # ================================================

                        echo ""
                        echo "=========================================="
                        echo "CONFIGURING IRSA"
                        echo "=========================================="

                        kubectl annotate serviceaccount \
                            "${LBC_SERVICE_ACCOUNT}" \
                            -n "${LBC_NAMESPACE}" \
                            "eks.amazonaws.com/role-arn=${ROLE_ARN}" \
                            --overwrite


                        echo ""
                        echo "ServiceAccount:"

                        kubectl get serviceaccount \
                            "${LBC_SERVICE_ACCOUNT}" \
                            -n "${LBC_NAMESPACE}" \
                            -o yaml


                        # ================================================
                        # HELM
                        # ================================================

                        echo ""
                        echo "=========================================="
                        echo "CONFIGURING HELM"
                        echo "=========================================="

                        helm repo add eks \
                            https://aws.github.io/eks-charts \
                            >/dev/null 2>&1 || true

                        helm repo update


                        # ================================================
                        # AWS LOAD BALANCER CONTROLLER
                        # ================================================

                        echo ""
                        echo "=========================================="
                        echo "AWS LOAD BALANCER CONTROLLER"
                        echo "=========================================="

                        helm upgrade --install \
                            aws-load-balancer-controller \
                            eks/aws-load-balancer-controller \
                            --namespace "${LBC_NAMESPACE}" \
                            --set clusterName="${EKS_CLUSTER_NAME}" \
                            --set serviceAccount.create=false \
                            --set serviceAccount.name="${LBC_SERVICE_ACCOUNT}" \
                            --set region="${AWS_REGION}" \
                            --set vpcId="${VPC_ID}" \
                            --timeout 10m


                        # ================================================
                        # CONTROLLER ROLLOUT
                        # ================================================

                        echo ""
                        echo "=========================================="
                        echo "WAITING FOR LOAD BALANCER CONTROLLER"
                        echo "=========================================="

                        kubectl rollout status \
                            deployment/aws-load-balancer-controller \
                            -n "${LBC_NAMESPACE}" \
                            --timeout=180s


                        kubectl get pods \
                            -n "${LBC_NAMESPACE}" \
                            -l app.kubernetes.io/name=aws-load-balancer-controller \
                            -o wide


                        # ================================================
                        # WEBHOOK TLS SECRET
                        # ================================================

                        echo ""
                        echo "=========================================="
                        echo "VERIFYING WEBHOOK TLS SECRET"
                        echo "=========================================="

                        if ! kubectl get secret \
                            aws-load-balancer-tls \
                            -n "${LBC_NAMESPACE}" \
                            >/dev/null 2>&1
                        then

                            echo "ERROR: aws-load-balancer-tls not found."

                            kubectl get secrets \
                                -n "${LBC_NAMESPACE}" \
                                | grep -E 'aws-load-balancer|webhook' || true

                            exit 1

                        fi


                        kubectl get secret \
                            aws-load-balancer-tls \
                            -n "${LBC_NAMESPACE}"


                        # ================================================
                        # WEBHOOK CA BUNDLE
                        # ================================================

                        echo ""
                        echo "=========================================="
                        echo "RECONCILING WEBHOOK CA BUNDLE"
                        echo "=========================================="

                        python3 <<'PY'
import base64
import json
import subprocess
import sys

def get_json(args):
    return json.loads(
        subprocess.check_output(
            ["kubectl"] + args,
            text=True
        )
    )

secret = get_json([
    "get",
    "secret",
    "aws-load-balancer-tls",
    "-n",
    "kube-system",
    "-o",
    "json"
])

ca_b64 = secret.get("data", {}).get("ca.crt")

if not ca_b64:
    print("ERROR: ca.crt missing from aws-load-balancer-tls")
    sys.exit(1)

try:
    base64.b64decode(ca_b64)
except Exception:
    print("ERROR: invalid ca.crt")
    sys.exit(1)

for kind in [
    "mutatingwebhookconfiguration",
    "validatingwebhookconfiguration"
]:

    name = "aws-load-balancer-webhook"

    config = get_json([
        "get",
        kind,
        name,
        "-o",
        "json"
    ])

    webhooks = config.get("webhooks", [])

    if not webhooks:
        print(f"ERROR: {kind}/{name} has no webhooks")
        sys.exit(1)

    for index in range(len(webhooks)):

        patch = json.dumps([
            {
                "op": "replace",
                "path": f"/webhooks/{index}/clientConfig/caBundle",
                "value": ca_b64
            }
        ])

        subprocess.check_call([
            "kubectl",
            "patch",
            kind,
            name,
            "--type=json",
            "-p",
            patch
        ])

    print(f"CA bundle synchronized: {kind}/{name}")

PY


                        # ================================================
                        # VERIFY EKS OIDC / IRSA CONFIGURATION
                        # ================================================

                        echo ""
                        echo "=========================================="
                        echo "VERIFYING EKS OIDC / IRSA"
                        echo "=========================================="

                        OIDC_ISSUER=$(aws eks describe-cluster \
                            --region "${AWS_REGION}" \
                            --name "${EKS_CLUSTER_NAME}" \
                            --query 'cluster.identity.oidc.issuer' \
                            --output text)

                        OIDC_PROVIDER=$(echo "${OIDC_ISSUER}" | sed 's#https://##')

                        echo "EKS OIDC Issuer:"
                        echo "${OIDC_ISSUER}"

                        ROLE_NAME=$(echo "${ROLE_ARN}" | awk -F/ '{print $NF}')

                        echo "IAM Role:"
                        echo "${ROLE_NAME}"

                        echo ""
                        echo "IAM Role Trust Policy:"
                        aws iam get-role \
                            --role-name "${ROLE_NAME}" \
                            --query 'Role.AssumeRolePolicyDocument' \
                            --output json

                        echo ""
                        echo "Verifying IAM OIDC provider exists..."

                        aws iam get-open-id-connect-provider \
                            --open-id-connect-provider-arn "arn:aws:iam::${AWS_ACCOUNT_ID}:oidc-provider/${OIDC_PROVIDER}" \
                            >/dev/null

                        echo "Correct EKS OIDC provider exists."

                        echo ""
                        echo "Expected IRSA subject:"
                        echo "system:serviceaccount:${LBC_NAMESPACE}:${LBC_SERVICE_ACCOUNT}"

                        echo ""
                        echo "ServiceAccount annotation:"
                        kubectl get serviceaccount \
                            "${LBC_SERVICE_ACCOUNT}" \
                            -n "${LBC_NAMESPACE}" \
                            -o jsonpath='{.metadata.annotations.eks\.amazonaws\.com/role-arn}'

                        echo ""

                        # ================================================
                        # RESTART CONTROLLER
                        # ================================================

                        echo ""
                        echo "=========================================="
                        echo "RESTARTING LOAD BALANCER CONTROLLER"
                        echo "=========================================="

                        kubectl rollout restart \
                            deployment/aws-load-balancer-controller \
                            -n "${LBC_NAMESPACE}"


                        kubectl rollout status \
                            deployment/aws-load-balancer-controller \
                            -n "${LBC_NAMESPACE}" \
                            --timeout=180s


                        echo ""
                        echo "Controller pods after restart:"

                        kubectl get pods \
                            -n "${LBC_NAMESPACE}" \
                            -l app.kubernetes.io/name=aws-load-balancer-controller \
                            -o wide


                        # ================================================
                        # WEBHOOK SERVICE
                        # ================================================

                        echo ""
                        echo "=========================================="
                        echo "VERIFYING WEBHOOK SERVICE"
                        echo "=========================================="

                        kubectl get service \
                            aws-load-balancer-webhook-service \
                            -n "${LBC_NAMESPACE}" \
                            -o wide


                        kubectl get endpointslice \
                            -n "${LBC_NAMESPACE}" \
                            -l kubernetes.io/service-name=aws-load-balancer-webhook-service \
                            -o wide


                        # ================================================
                        # DEPLOYMENT
                        # ================================================

                        echo ""
                        echo "=========================================="
                        echo "DEPLOYMENT.YML"
                        echo "=========================================="

                        kubectl apply \
                            -f k8s/deployment.yml \
                            -n "${K8S_NAMESPACE}"


                        kubectl rollout status \
                            deployment/flipkart-app \
                            -n "${K8S_NAMESPACE}" \
                            --timeout=180s


                        # ================================================
                        # SERVICE
                        # ================================================

                        echo ""
                        echo "=========================================="
                        echo "SERVICE.YML"
                        echo "=========================================="

                        kubectl apply \
                            -f k8s/service.yml \
                            -n "${K8S_NAMESPACE}"


                        # ================================================
                        # INGRESS
                        # ================================================

                        echo ""
                        echo "=========================================="
                        echo "INGRESS.YML"
                        echo "=========================================="

                        kubectl apply \
                            -f k8s/ingress.yml \
                            -n "${K8S_NAMESPACE}"

                        # ================================================
                        # WAIT FOR ALB
                        # ================================================

                        echo ""
                        echo "=========================================="
                        echo "WAITING FOR AWS ALB"
                        echo "=========================================="

                        ALB_ADDRESS=""

                        for i in $(seq 1 30); do

                            ALB_ADDRESS=$(kubectl get ingress \
                                -n "${K8S_NAMESPACE}" \
                                -o jsonpath='{.items[0].status.loadBalancer.ingress[0].hostname}' \
                                2>/dev/null || true)

                            if [ -n "${ALB_ADDRESS}" ]; then
                                echo "ALB DNS:"
                                echo "${ALB_ADDRESS}"
                                break
                            fi

                            echo "Waiting for ALB... (${i}/30)"
                            sleep 10

                        done

                        if [ -z "${ALB_ADDRESS}" ]; then
                            echo "WARNING: ALB DNS is not available yet."
                            kubectl describe ingress \
                                -n "${K8S_NAMESPACE}" || true
                        fi

                        # ================================================
                        # FINAL VERIFICATION
                        # ================================================

                        echo ""
                        echo "=========================================="
                        echo "FINAL KUBERNETES VERIFICATION"
                        echo "=========================================="

                        kubectl get pods \
                            -n "${K8S_NAMESPACE}" \
                            -o wide

                        kubectl get deployments \
                            -n "${K8S_NAMESPACE}"

                        kubectl get services \
                            -n "${K8S_NAMESPACE}"

                        kubectl get ingress \
                            -n "${K8S_NAMESPACE}" \
                            -o wide || true

                        kubectl get ingressclass || true


                        # ================================================
                        # ALB
                        # ================================================

                        echo ""
                        echo "=========================================="
                        echo "ALB ADDRESS"
                        echo "=========================================="

                        ALB_ADDRESS=$(kubectl get ingress \
                            -n "${K8S_NAMESPACE}" \
                            -o jsonpath='{.items[0].status.loadBalancer.ingress[0].hostname}' \
                            2>/dev/null || true)


                        if [ -n "${ALB_ADDRESS}" ]; then

                            echo "ALB DNS:"
                            echo "${ALB_ADDRESS}"

                            echo ""
                            echo "=========================================="
                            echo "TESTING APPLICATION THROUGH ALB"
                            echo "=========================================="

                            echo "Testing:"
                            echo "http://${ALB_ADDRESS}"

                            HTTP_STATUS=$(curl -sS -o /tmp/flipkart-alb-response.html \
                                -w "%{http_code}" \
                                --connect-timeout 10 \
                                --max-time 30 \
                                "http://${ALB_ADDRESS}" || true)

                            echo "HTTP status: ${HTTP_STATUS}"

                            if [ "${HTTP_STATUS}" = "200" ]; then
                                echo "Application is reachable through AWS ALB."
                            else
                                echo "WARNING: ALB returned HTTP status ${HTTP_STATUS}."
                                echo "Response preview:"
                                head -20 /tmp/flipkart-alb-response.html 2>/dev/null || true
                            fi

                            rm -f /tmp/flipkart-alb-response.html

                        else

                            echo "ALB DNS is not available yet."

                            echo "Run:"
                            echo "kubectl get ingress -n ${K8S_NAMESPACE} -w"

                        fi


                        echo ""
                        echo "=========================================="
                        echo "KUBERNETES DEPLOYMENT COMPLETED"
                        echo "=========================================="
                    '''
                }
            }
        }
    }


    // =============================================================
    // POST
    // =============================================================

    post {

        success {

            echo '=========================================='
            echo '          PIPELINE SUCCESSFUL'
            echo '=========================================='

            echo "EKS Cluster: ${EKS_CLUSTER_NAME}"
            echo "Namespace: ${K8S_NAMESPACE}"
            echo "Region: ${AWS_REGION}"
            echo "ECR Image: ${ECR_IMAGE}"

            echo '=========================================='
        }


        failure {

            echo '=========================================='
            echo '            PIPELINE FAILED'
            echo '=========================================='

            echo 'Check the FIRST failed stage above.'

            echo ''
            echo 'Required Jenkins configuration:'
            echo 'AWS credentials ID: aws-credentials'
            echo 'SonarQube token ID: sonarqube-token'
            echo 'SonarQube server: SonarQube'
            echo 'SonarScanner tool: SonarScanner'

            echo '=========================================='
        }


        always {

            echo '=========================================='
            echo '       CLEANING TEMPORARY FILES'
            echo '=========================================='

            sh '''
                set +e

                rm -rf "${WORKSPACE}/.venv"
                rm -rf "${WORKSPACE}/.kube"
                rm -rf "${WORKSPACE}/.trivy-cache"
                rm -rf "${WORKSPACE}/.trivy-image-cache"

                echo "Temporary files cleaned."
            '''

            cleanWs()
        }
    }
}

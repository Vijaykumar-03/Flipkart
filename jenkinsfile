pipeline {

    agent any

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    environment {

        // =========================================================
        // GIT
        // =========================================================

        GIT_REPO = 'https://github.com/Vijaykumar-03/Flipkart.git'
        GIT_BRANCH = 'main'


        // =========================================================
        // AWS
        // =========================================================

        AWS_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = '847547470089'

        ECR_REGISTRY =
            '847547470089.dkr.ecr.ap-south-1.amazonaws.com'


        // =========================================================
        // ECR
        // =========================================================

        ECR_REPOSITORY = 'devops-ecr'
        IMAGE_NAME = 'devops-ecr'
        IMAGE_TAG = 'v1'

        FULL_IMAGE =
            '847547470089.dkr.ecr.ap-south-1.amazonaws.com/devops-ecr:v1'


        // =========================================================
        // EKS
        // =========================================================

        EKS_CLUSTER_NAME = 'devops-eks'


        // =========================================================
        // KUBERNETES
        // =========================================================

        K8S_NAMESPACE = 'default'


        // =========================================================
        // SONARQUBE
        // =========================================================

        SONAR_PROJECT_KEY = 'flipkart'
        SONAR_PROJECT_NAME = 'Flipkart'
    }


    stages {


        // =========================================================
        // 1. CHECKOUT
        // =========================================================

        stage('Checkout') {

            steps {

                echo '=========================================='
                echo 'CHECKING OUT SOURCE CODE'
                echo '=========================================='

                deleteDir()

                git(
                    branch: "${GIT_BRANCH}",
                    url: "${GIT_REPO}"
                )

                echo ''
                echo 'Source code checkout completed.'
            }
        }


        // =========================================================
        // 2. CHECK REQUIRED TOOLS
        // =========================================================

        stage('Check Required Tools') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "CHECKING REQUIRED TOOLS"
                    echo "=========================================="

                    echo ""
                    echo "Python:"
                    python3 --version

                    echo ""
                    echo "Docker:"
                    docker --version

                    echo ""
                    echo "AWS CLI:"
                    aws --version

                    echo ""
                    echo "Trivy:"
                    trivy --version

                    echo ""
                    echo "Kubectl:"
                    kubectl version --client

                    echo ""
                    echo "Git:"
                    git --version

                    echo ""
                    echo "=========================================="
                '''
            }
        }


        // =========================================================
        // 3. PREPARE PYTHON
        // =========================================================

        stage('Prepare Python') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "PREPARING PYTHON"
                    echo "=========================================="

                    rm -rf .venv

                    python3 -m venv .venv

                    . .venv/bin/activate

                    python --version
                    pip --version

                    echo ""
                    echo "Python virtual environment created."
                    echo "=========================================="
                '''
            }
        }


        // =========================================================
        // 4. INSTALL DEPENDENCIES
        // =========================================================

        stage('Install Dependencies') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "INSTALLING DEPENDENCIES"
                    echo "=========================================="

                    . .venv/bin/activate

                    python -m pip install --upgrade pip

                    if [ -f requirements.txt ]
                    then
                        pip install -r requirements.txt
                    else
                        echo "WARNING: requirements.txt not found."
                    fi

                    echo ""
                    echo "Dependencies installed."
                    echo "=========================================="
                '''
            }
        }


        // =========================================================
        // 5. LINT
        // =========================================================

        stage('Lint') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "RUNNING LINT"
                    echo "=========================================="

                    . .venv/bin/activate

                    pip install flake8

                    flake8 . \
                        --exclude=.venv,venv,env,.git,\
__pycache__,.pytest_cache \
                        --max-line-length=88

                    echo ""
                    echo "Lint passed."
                    echo "=========================================="
                '''
            }
        }


        // =========================================================
        // 6. UNIT TEST
        // =========================================================

        stage('Unit Test') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "RUNNING UNIT TESTS"
                    echo "=========================================="

                    . .venv/bin/activate

                    if [ -d tests ]
                    then

                        pip install pytest

                        pytest -v

                    else

                        echo ""
                        echo "WARNING: tests directory not found."
                        echo "Skipping unit tests."

                    fi

                    echo ""
                    echo "Unit test stage completed."
                    echo "=========================================="
                '''
            }
        }


        // =========================================================
        // 7. SONARQUBE
        // =========================================================

        stage('SonarQube Analysis') {

            steps {

                echo '=========================================='
                echo 'SONARQUBE ANALYSIS'
                echo '=========================================='

                script {

                    def sonarInstalled = sh(
                        script: '''
                            command -v sonar-scanner \
                            >/dev/null 2>&1
                        ''',
                        returnStatus: true
                    )

                    if (sonarInstalled == 0) {

                        withSonarQubeEnv('SonarQube') {

                            sh """
                                sonar-scanner \
                                -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                                -Dsonar.projectName=${SONAR_PROJECT_NAME} \
                                -Dsonar.sources=. \
                                -Dsonar.exclusions=.venv/**,venv/**,env/**,.git/**,__pycache__/**,tests/**
                            """
                        }

                    } else {

                        echo ''
                        echo 'WARNING: sonar-scanner not installed.'
                        echo 'Skipping SonarQube analysis.'

                    }
                }

                echo '=========================================='
            }
        }


        // =========================================================
        // 8. TRIVY FILESYSTEM SCAN
        // =========================================================

        stage('Trivy Filesystem Scan') {

            steps {

                sh '''
                    set +e

                    echo "=========================================="
                    echo "TRIVY FILESYSTEM SCAN"
                    echo "=========================================="

                    trivy fs \
                        --severity HIGH,CRITICAL \
                        --exit-code 0 \
                        --scanners vuln,secret,misconfig \
                        .

                    echo ""
                    echo "Filesystem scan completed."

                    exit 0
                '''
            }
        }


        // =========================================================
        // 9. DOCKER CLEANUP
        // =========================================================

        stage('Docker Cleanup') {

            steps {

                sh '''
                    set +e

                    echo "=========================================="
                    echo "DOCKER CLEANUP"
                    echo "=========================================="

                    docker container prune -f
                    docker image prune -af
                    docker builder prune -af

                    echo ""
                    echo "Docker cleanup completed."

                    exit 0
                '''
            }
        }


        // =========================================================
        // 10. BUILD DOCKER IMAGE
        // =========================================================

        stage('Build Docker Image') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "BUILDING DOCKER IMAGE"
                    echo "=========================================="

                    if [ ! -f Dockerfile ]
                    then

                        echo "ERROR: Dockerfile not found."
                        exit 1

                    fi

                    echo ""
                    echo "Image:"
                    echo "${IMAGE_NAME}:${IMAGE_TAG}"

                    docker build \
                        --pull \
                        -t "${IMAGE_NAME}:${IMAGE_TAG}" \
                        .

                    echo ""
                    echo "Docker image built successfully."
                    echo "=========================================="
                '''
            }
        }


        // =========================================================
        // 11. TAG DOCKER IMAGE
        // =========================================================

        stage('Tag Docker Image') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "TAGGING DOCKER IMAGE"
                    echo "=========================================="

                    docker tag \
                        "${IMAGE_NAME}:${IMAGE_TAG}" \
                        "${FULL_IMAGE}"

                    echo ""
                    echo "Image tagged as:"
                    echo "${FULL_IMAGE}"

                    echo "=========================================="
                '''
            }
        }


        // =========================================================
        // 12. TRIVY IMAGE SCAN
        // =========================================================

        stage('Trivy Image Scan') {

            steps {

                sh '''
                    set +e

                    echo "=========================================="
                    echo "TRIVY IMAGE SCAN"
                    echo "=========================================="

                    trivy image \
                        --severity HIGH,CRITICAL \
                        --exit-code 0 \
                        "${IMAGE_NAME}:${IMAGE_TAG}"

                    echo ""
                    echo "Image scan completed."

                    exit 0
                '''
            }
        }


        // =========================================================
        // 13. AWS AUTHENTICATION
        // =========================================================

        stage('AWS Authentication') {

            steps {

                echo '=========================================='
                echo 'AWS AUTHENTICATION'
                echo '=========================================='

                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {

                    sh '''
                        set -e

                        export AWS_DEFAULT_REGION="${AWS_REGION}"

                        echo ""
                        echo "Checking AWS credentials..."

                        aws sts get-caller-identity

                        echo ""
                        echo "AWS authentication successful."

                        echo "=========================================="
                    '''
                }
            }
        }


        // =========================================================
        // 14. ECR LOGIN
        // =========================================================

        stage('ECR Login') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {

                    sh '''
                        set -e

                        export AWS_DEFAULT_REGION="${AWS_REGION}"

                        echo "=========================================="
                        echo "ECR LOGIN"
                        echo "=========================================="

                        aws ecr get-login-password \
                            --region "${AWS_REGION}" \
                        | docker login \
                            --username AWS \
                            --password-stdin \
                            "${ECR_REGISTRY}"

                        echo ""
                        echo "ECR login successful."
                        echo "=========================================="
                    '''
                }
            }
        }


        // =========================================================
        // 15. CHECK ECR REPOSITORY
        // =========================================================

        stage('Check ECR Repository') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {

                    sh '''
                        set -e

                        export AWS_DEFAULT_REGION="${AWS_REGION}"

                        echo "=========================================="
                        echo "CHECKING ECR REPOSITORY"
                        echo "=========================================="

                        if aws ecr describe-repositories \
                            --repository-names "${ECR_REPOSITORY}" \
                            --region "${AWS_REGION}" \
                            >/dev/null 2>&1
                        then

                            echo ""
                            echo "ECR repository exists:"
                            echo "${ECR_REPOSITORY}"

                        else

                            echo ""
                            echo "ECR repository not found."
                            echo "Creating repository..."

                            aws ecr create-repository \
                                --repository-name "${ECR_REPOSITORY}" \
                                --region "${AWS_REGION}"

                            echo ""
                            echo "ECR repository created."

                        fi

                        echo "=========================================="
                    '''
                }
            }
        }


        // =========================================================
        // 16. PUSH IMAGE TO ECR
        // =========================================================

        stage('Push Image to ECR') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {

                    sh '''
                        set -e

                        export AWS_DEFAULT_REGION="${AWS_REGION}"

                        echo "=========================================="
                        echo "PUSHING IMAGE TO ECR"
                        echo "=========================================="

                        echo ""
                        echo "Image:"
                        echo "${FULL_IMAGE}"

                        docker push "${FULL_IMAGE}"

                        echo ""
                        echo "Image pushed successfully."

                        echo "=========================================="
                    '''
                }
            }
        }


        // =========================================================
        // 17. CONNECT TO EKS
        // =========================================================

        stage('Connect to EKS') {

            steps {

                echo '=========================================='
                echo 'CONNECTING TO EKS'
                echo '=========================================='

                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {

                    sh '''
                        set -e

                        export AWS_DEFAULT_REGION="${AWS_REGION}"

                        mkdir -p "${WORKSPACE}/.kube"

                        export KUBECONFIG="${WORKSPACE}/.kube/config"

                        echo ""
                        echo "EKS Cluster:"
                        echo "${EKS_CLUSTER_NAME}"

                        echo ""
                        echo "Updating kubeconfig..."

                        aws eks update-kubeconfig \
                            --region "${AWS_REGION}" \
                            --name "${EKS_CLUSTER_NAME}" \
                            --kubeconfig "${KUBECONFIG}"

                        echo ""
                        echo "Testing Kubernetes connection..."

                        kubectl get nodes

                        echo ""
                        echo "EKS connection successful."

                        echo "=========================================="
                    '''
                }
            }
        }


        // =========================================================
        // 18. CHECK KUBERNETES YML FILES
        // =========================================================

        stage('Check Kubernetes YML') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "CHECKING KUBERNETES YML FILES"
                    echo "=========================================="

                    echo ""
                    echo "Checking:"
                    echo "k8s/deployment.yml"
                    echo "k8s/service.yml"
                    echo "k8s/ingress.yml"

                    if [ ! -f k8s/deployment.yml ]
                    then

                        echo ""
                        echo "ERROR: k8s/deployment.yml not found."
                        exit 1

                    fi

                    if [ ! -f k8s/service.yml ]
                    then

                        echo ""
                        echo "ERROR: k8s/service.yml not found."
                        exit 1

                    fi

                    if [ ! -f k8s/ingress.yml ]
                    then

                        echo ""
                        echo "ERROR: k8s/ingress.yml not found."
                        exit 1

                    fi

                    echo ""
                    echo "All Kubernetes YML files found."

                    echo ""
                    echo "=========================================="
                '''
            }
        }


        // =========================================================
        // 19. VALIDATE DEPLOYMENT YML
        // =========================================================

        stage('Validate Kubernetes YML') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "VALIDATING KUBERNETES YML"
                    echo "=========================================="

                    export KUBECONFIG="${WORKSPACE}/.kube/config"

                    kubectl apply \
                        --dry-run=client \
                        -f k8s/deployment.yml

                    kubectl apply \
                        --dry-run=client \
                        -f k8s/service.yml

                    kubectl apply \
                        --dry-run=client \
                        -f k8s/ingress.yml

                    echo ""
                    echo "Kubernetes YAML validation successful."

                    echo "=========================================="
                '''
            }
        }


        // =========================================================
        // 20. DEPLOY APPLICATION
        // =========================================================

        stage('Deploy Application') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "DEPLOYING APPLICATION"
                    echo "=========================================="

                    export KUBECONFIG="${WORKSPACE}/.kube/config"

                    echo ""
                    echo "Image:"
                    echo "${FULL_IMAGE}"

                    echo ""
                    echo "Updating k8s/deployment.yml..."

                    sed -i \
                        "s|IMAGE_PLACEHOLDER|${FULL_IMAGE}|g" \
                        k8s/deployment.yml

                    echo ""
                    echo "Applying deployment..."

                    kubectl apply \
                        -f k8s/deployment.yml \
                        -n "${K8S_NAMESPACE}"

                    echo ""
                    echo "Application deployment successful."

                    echo "=========================================="
                '''
            }
        }


        // =========================================================
        // 21. DEPLOY SERVICE
        // =========================================================

        stage('Deploy Service') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "DEPLOYING SERVICE"
                    echo "=========================================="

                    export KUBECONFIG="${WORKSPACE}/.kube/config"

                    kubectl apply \
                        -f k8s/service.yml \
                        -n "${K8S_NAMESPACE}"

                    echo ""
                    echo "Service deployed successfully."

                    echo ""
                    echo "Services:"

                    kubectl get services \
                        -n "${K8S_NAMESPACE}"

                    echo "=========================================="
                '''
            }
        }


        // =========================================================
        // 22. DEPLOY INGRESS
        // =========================================================

        stage('Deploy Ingress') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "DEPLOYING INGRESS"
                    echo "=========================================="

                    export KUBECONFIG="${WORKSPACE}/.kube/config"

                    kubectl apply \
                        -f k8s/ingress.yml \
                        -n "${K8S_NAMESPACE}"

                    echo ""
                    echo "Ingress deployed successfully."

                    echo ""
                    echo "Ingress:"

                    kubectl get ingress \
                        -n "${K8S_NAMESPACE}"

                    echo "=========================================="
                '''
            }
        }


        // =========================================================
        // 23. VERIFY DEPLOYMENT
        // =========================================================

        stage('Verify Deployment') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "VERIFYING DEPLOYMENT"
                    echo "=========================================="

                    export KUBECONFIG="${WORKSPACE}/.kube/config"

                    echo ""
                    echo "Kubernetes Nodes:"
                    kubectl get nodes

                    echo ""
                    echo "Deployments:"
                    kubectl get deployments \
                        -n "${K8S_NAMESPACE}"

                    echo ""
                    echo "Pods:"
                    kubectl get pods \
                        -n "${K8S_NAMESPACE}" \
                        -o wide

                    echo ""
                    echo "Services:"
                    kubectl get services \
                        -n "${K8S_NAMESPACE}"

                    echo ""
                    echo "Ingress:"
                    kubectl get ingress \
                        -n "${K8S_NAMESPACE}"

                    echo ""
                    echo "Checking rollout..."

                    DEPLOYMENT_NAME=$(kubectl get deployment \
                        -n "${K8S_NAMESPACE}" \
                        -o jsonpath='{.items[0].metadata.name}')

                    if [ -z "${DEPLOYMENT_NAME}" ]
                    then

                        echo ""
                        echo "ERROR: No deployment found."
                        exit 1

                    fi

                    echo ""
                    echo "Deployment:"
                    echo "${DEPLOYMENT_NAME}"

                    kubectl rollout status \
                        deployment/"${DEPLOYMENT_NAME}" \
                        -n "${K8S_NAMESPACE}" \
                        --timeout=180s

                    echo ""
                    echo "=========================================="
                    echo "DEPLOYMENT VERIFIED SUCCESSFULLY"
                    echo "=========================================="
                '''
            }
        }
    }


    // =============================================================
    // POST ACTIONS
    // =============================================================

    post {

        success {

            echo '=========================================='
            echo '          PIPELINE SUCCESSFUL'
            echo '=========================================='

            echo ''
            echo "ECR Repository: ${ECR_REPOSITORY}"
            echo "Image Tag:      ${IMAGE_TAG}"
            echo "Docker Image:   ${FULL_IMAGE}"
            echo "EKS Cluster:    ${EKS_CLUSTER_NAME}"
            echo "AWS Region:     ${AWS_REGION}"

            echo ''
            echo '=========================================='
        }


        failure {

            echo '=========================================='
            echo '            PIPELINE FAILED'
            echo '=========================================='

            echo ''
            echo 'Check the FIRST failed stage above.'
            echo ''

            echo '=========================================='
        }


        always {

            echo '=========================================='
            echo '       CLEANING TEMPORARY FILES'
            echo '=========================================='

            sh '''
                set +e

                rm -rf "${WORKSPACE}/.venv"
                rm -rf "${WORKSPACE}/.trivy-cache"
                rm -rf "${WORKSPACE}/.trivy-image-cache"
                rm -rf "${WORKSPACE}/.kube"

                docker logout "${ECR_REGISTRY}" >/dev/null 2>&1

                echo ""
                echo "Cleanup completed."
            '''

            cleanWs()
        }
    }
}

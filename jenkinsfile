pipeline {

    agent any

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    environment {

        GIT_REPO   = 'https://github.com/Vijaykumar-03/Flipkart.git'
        GIT_BRANCH = 'main'
        AWS_REGION = 'ap-south-1'
        ECR_IMAGE = '847547470089.dkr.ecr.ap-south-1.amazonaws.com/devops-ecr:v1'

        EKS_CLUSTER_NAME = 'devops-eks'

        VPC_ID = 'vpc-06219807031b348d2'
        K8S_NAMESPACE = 'default'

        LBC_NAMESPACE       = 'kube-system'
        LBC_SERVICE_ACCOUNT = 'aws-load-balancer-controller'

        LBC_POLICY_ARN = 'arn:aws:iam::847547470089:policy/AWSLoadBalancerControllerIAMPolicy'

        SONAR_PROJECT_KEY  = 'flipkart'
        SONAR_PROJECT_NAME = 'Flipkart'

        // Jenkins credential IDs
        AWS_CREDENTIALS_ID   = 'aws-credentials'
        SONAR_CREDENTIALS_ID = 'sonarqube-token'

        // AWS Load Balancer Controller
        LBC_ROLE_NAME = 'eksctl-devops-eks-addon-iamserviceaccount-kub-Role1-3RgpiWDHVFbC'
    }


    stages {
        stage('Checkout') {

            steps {

                echo '=========================================='
                echo 'CHECKING OUT SOURCE CODE'
                echo '=========================================='

                deleteDir()

                git(
                    branch: "${GIT_BRANCH}",
                    url: "${GIT_REPO}"
                )

                echo ''
                echo 'Source code checkout completed.'
            }
        }

        stage('Python Environment') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "PYTHON ENVIRONMENT"
                    echo "=========================================="

                    python3 --version

                    rm -rf .venv

                    python3 -m venv .venv

                    . .venv/bin/activate

                    python --version
                    pip --version

                    echo ""
                    echo "Python virtual environment created."
                '''
            }
        }

        stage('Install Python Dependencies') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "INSTALL PYTHON DEPENDENCIES"
                    echo "=========================================="

                    . .venv/bin/activate

                    python -m pip install --upgrade pip

                    if [ -f requirements.txt ]
                    then
                        pip install -r requirements.txt
                    else
                        echo "ERROR: requirements.txt not found."
                        exit 1
                    fi

                    echo ""
                    echo "Python dependencies installed."
                '''
            }
        }


        // =========================================================
        // 4. LINT
        // =========================================================

        stage('Lint') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "PYTHON LINT"
                    echo "=========================================="

                    . .venv/bin/activate

                    pip install flake8

                    flake8 . \
                        --exclude=.venv,venv,env,.git,__pycache__,.pytest_cache \
                        --max-line-length=88

                    echo ""
                    echo "Lint completed successfully."
                '''
            }
        }

        stage('Unit Test') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "PYTHON UNIT TEST"
                    echo "=========================================="

                    . .venv/bin/activate

                    if [ -d tests ]
                    then

                        pip install pytest

                        pytest -v

                    else

                        echo ""
                        echo "WARNING: tests directory not found."
                        echo "Skipping unit tests."

                    fi

                    echo ""
                    echo "Unit test stage completed."
                '''
            }
        }

        stage('SonarQube Analysis') {

            steps {

                script {

                    def sonarInstalled = sh(
                        script: '''
                            command -v sonar-scanner >/dev/null 2>&1
                        ''',
                        returnStatus: true
                    )

                    if (sonarInstalled == 0) {

                        withSonarQubeEnv('SonarQube') {
                            withCredentials([
                                string(
                                    credentialsId: "${SONAR_CREDENTIALS_ID}",
                                    variable: 'SONAR_TOKEN'
                                )
                            ]) {
                                sh '''
                                    set -e

                                    sonar-scanner \
                                      -Dsonar.projectKey="${SONAR_PROJECT_KEY}" \
                                      -Dsonar.projectName="${SONAR_PROJECT_NAME}" \
                                      -Dsonar.sources=. \
                                      -Dsonar.token="${SONAR_TOKEN}" \
                                      -Dsonar.exclusions=.venv/**,venv/**,env/**,.git/**,__pycache__/**,tests/**
                                '''
                            }
                        }

                    } else {

                        echo ''
                        echo 'WARNING: sonar-scanner is not installed.'
                        echo 'Skipping SonarQube analysis.'
                    }
                }
            }
        }

        stage('SonarQube Quality Gate') {
            steps {
                script {
                    try {
                        timeout(time: 5, unit: 'MINUTES') {
                            waitForQualityGate abortPipeline: true
                        }
                    } catch (Exception e) {
                        echo "WARNING: SonarQube Quality Gate could not be evaluated: ${e.message}"
                        echo "Ensure the SonarQube webhook is configured in Jenkins."
                    }
                }
            }
        }

        stage('Trivy Filesystem Scan') {

            steps {

                sh '''
                    set +e

                    echo "=========================================="
                    echo "TRIVY FILESYSTEM SCAN"
                    echo "=========================================="

                    trivy fs \
                        --severity HIGH,CRITICAL \
                        --exit-code 0 \
                        --scanners vuln,secret,misconfig \
                        .

                    echo ""
                    echo "Filesystem scan completed."

                    exit 0
                '''
            }
        }

        stage('Trivy ECR Image Scan') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {

                    sh '''
                        set +e

                        export AWS_DEFAULT_REGION="${AWS_REGION}"

                        echo "=========================================="
                        echo "TRIVY ECR IMAGE SCAN"
                        echo "=========================================="

                        echo ""
                        echo "Existing ECR image:"
                        echo "${ECR_IMAGE}"

                        trivy image \
                            --severity HIGH,CRITICAL \
                            --exit-code 0 \
                            "${ECR_IMAGE}"

                        echo ""
                        echo "ECR image scan completed."

                        exit 0
                    '''
                }
            }
        }


        stage('Kubernetes Deployment') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {

                    sh '''
                        set -e

                        export AWS_DEFAULT_REGION="${AWS_REGION}"


                        echo "=========================================="
                        echo "KUBERNETES DEPLOYMENT"
                        echo "=========================================="

                        rm -rf "${WORKSPACE}/.kube"

                        mkdir -p "${WORKSPACE}/.kube"

                        export KUBECONFIG="${WORKSPACE}/.kube/config"

                        echo ""
                        echo "=========================================="
                        echo "AWS IDENTITY"
                        echo "=========================================="

                        aws sts get-caller-identity

                        echo ""
                        echo "=========================================="
                        echo "CONFIGURING EKS"
                        echo "=========================================="

                        aws eks update-kubeconfig \
                            --region "${AWS_REGION}" \
                            --name "${EKS_CLUSTER_NAME}" \
                            --kubeconfig "${KUBECONFIG}"

                        echo ""
                        echo "Current Kubernetes context:"

                        kubectl config current-context

                        echo ""
                        echo "=========================================="
                        echo "VERIFYING EKS CONNECTION"
                        echo "=========================================="

                        kubectl --request-timeout=20s get nodes

                        echo ""
                        echo "EKS nodes:"
                        kubectl get nodes -o wide

                        echo ""
                        echo "=========================================="
                        echo "CHECKING EKS OIDC"
                        echo "=========================================="

                        OIDC_ISSUER=$(aws eks describe-cluster \
                            --region "${AWS_REGION}" \
                            --name "${EKS_CLUSTER_NAME}" \
                            --query 'cluster.identity.oidc.issuer' \
                            --output text)

                        echo "OIDC issuer:"
                        echo "${OIDC_ISSUER}"

                        if [ -z "${OIDC_ISSUER}" ] || [ "${OIDC_ISSUER}" = "None" ]
                        then
                            echo "ERROR: OIDC provider not available."
                            exit 1
                        fi


                        # =================================================
                        # CHECK IAM POLICY
                        # =================================================

                        echo ""
                        echo "=========================================="
                        echo "CHECKING LOAD BALANCER IAM POLICY"
                        echo "=========================================="

                        if aws iam get-policy \
                            --policy-arn "${LBC_POLICY_ARN}" \
                            >/dev/null 2>&1
                        then

                            echo "IAM policy exists."

                        else

                            echo "ERROR: AWS Load Balancer Controller IAM policy not found."
                            exit 1

                        fi

                        echo ""
                        echo "=========================================="
                        echo "CHECKING IAM SERVICE ACCOUNT"
                        echo "=========================================="

                        ROLE_ARN=""

                        # eksctl already has the IAM service account/CloudFormation
                        # resource in this cluster. Reuse its role instead of trying
                        # to create a duplicate CloudFormation stack.
                        ROLE_ARN=$(eksctl get iamserviceaccount \
                            --cluster="${EKS_CLUSTER_NAME}" \
                            --region="${AWS_REGION}" \
                            --output json 2>/dev/null \
                            | python3 -c 'import json,sys; data=json.load(sys.stdin); rows=data if isinstance(data,list) else data.get("iamserviceaccounts",[]); print(next((x.get("roleARN","") for x in rows if x.get("namespace")=="kube-system" and x.get("name")=="aws-load-balancer-controller"),""))' \
                            2>/dev/null || true)

                        if [ -z "${ROLE_ARN}" ]; then
                            ROLE_ARN=$(aws iam get-role \
                                --role-name "${LBC_ROLE_NAME}" \
                                --query 'Role.Arn' \
                                --output text 2>/dev/null || true)
                        fi

                        if [ -z "${ROLE_ARN}" ] || [ "${ROLE_ARN}" = "None" ]; then
                            echo "ERROR: AWS Load Balancer Controller IAM role not found."
                            echo "Expected role: ${LBC_ROLE_NAME}"
                            exit 1
                        fi

                        echo "IAM role: ${ROLE_ARN}"

                        echo ""
                        echo "Checking Kubernetes ServiceAccount..."

                        if kubectl get serviceaccount \
                            "${LBC_SERVICE_ACCOUNT}" \
                            -n "${LBC_NAMESPACE}" \
                            >/dev/null 2>&1
                        then
                            echo "ServiceAccount already exists."
                        else
                            echo "ServiceAccount does not exist. Creating it..."

                            kubectl create serviceaccount \
                                "${LBC_SERVICE_ACCOUNT}" \
                                -n "${LBC_NAMESPACE}"
                        fi

                        echo ""
                        echo "Applying IAM role annotation..."

                        kubectl annotate serviceaccount \
                            "${LBC_SERVICE_ACCOUNT}" \
                            -n "${LBC_NAMESPACE}" \
                            "eks.amazonaws.com/role-arn=${ROLE_ARN}" \
                            --overwrite

                        echo ""
                        echo "=========================================="
                        echo "VERIFYING SERVICE ACCOUNT"
                        echo "=========================================="

                        kubectl get serviceaccount \
                            "${LBC_SERVICE_ACCOUNT}" \
                            -n "${LBC_NAMESPACE}" \
                            -o yaml

                        SA_ROLE_ARN=$(kubectl get serviceaccount \
                            "${LBC_SERVICE_ACCOUNT}" \
                            -n "${LBC_NAMESPACE}" \
                            -o jsonpath='{.metadata.annotations.eks\.amazonaws\.com/role-arn}')

                        if [ -z "${SA_ROLE_ARN}" ]; then
                            echo "ERROR: IAM role annotation not found."
                            exit 1
                        fi

                        if [ "${SA_ROLE_ARN}" != "${ROLE_ARN}" ]; then
                            echo "ERROR: ServiceAccount IAM role ARN does not match expected role."
                            echo "Expected: ${ROLE_ARN}"
                            echo "Actual:   ${SA_ROLE_ARN}"
                            exit 1
                        fi

                        echo "ServiceAccount IAM annotation verified."

                        echo ""
                        echo "=========================================="
                        echo "CHECKING EKS INGRESS CLASS"
                        echo "=========================================="

                        if kubectl get ingressclass alb >/dev/null 2>&1; then
                            echo "ALB IngressClass exists."
                            kubectl get ingressclass alb
                        else
                            echo "WARNING: ALB IngressClass not found yet."
                        fi

                        echo ""
                        echo "=========================================="
                        echo "CHECKING LOAD BALANCER CONTROLLER CRDS"
                        echo "=========================================="

                        kubectl get crd | grep 'elbv2.k8s.aws' || true

                        echo ""
                        echo "=========================================="
                        echo "CONFIGURING HELM"
                        echo "=========================================="

                        helm repo add eks https://aws.github.io/eks-charts \
                            2>/dev/null || true

                        helm repo update

                        echo ""
                        echo "=========================================="
                        echo "AWS LOAD BALANCER CONTROLLER"
                        echo "=========================================="

                        helm upgrade --install \
                            aws-load-balancer-controller \
                            eks/aws-load-balancer-controller \
                            --namespace "${LBC_NAMESPACE}" \
                            --set clusterName="${EKS_CLUSTER_NAME}" \
                            --set serviceAccount.create=false \
                            --set serviceAccount.name="${LBC_SERVICE_ACCOUNT}" \
                            --set region="${AWS_REGION}" \
                            --set vpcId="${VPC_ID}" \
                            --wait \
                            --timeout 10m

                        echo ""
                        echo "Waiting for AWS Load Balancer Controller..."

                        kubectl rollout status \
                            deployment/aws-load-balancer-controller \
                            -n "${LBC_NAMESPACE}" \
                            --timeout=180s

                        echo ""
                        echo "Controller deployment:"
                        kubectl get deployment \
                            aws-load-balancer-controller \
                            -n "${LBC_NAMESPACE}" \
                            -o wide

                        echo ""
                        echo "Controller pods:"
                        kubectl get pods \
                            -n "${LBC_NAMESPACE}" \
                            -l app.kubernetes.io/name=aws-load-balancer-controller \
                            -o wide

                        echo ""
                        echo "Controller logs:"
                        kubectl logs \
                            -n "${LBC_NAMESPACE}" \
                            deployment/aws-load-balancer-controller \
                            --tail=50

                        echo ""
                        echo "Helm release:"
                        helm status aws-load-balancer-controller \
                            -n "${LBC_NAMESPACE}" || true
                        echo ""
                        echo "=========================================="
                        echo "DEPLOYMENT.YML"
                        echo "=========================================="

                        kubectl apply \
                            -f k8s/deployment.yml \
                            -n "${K8S_NAMESPACE}"
                        echo ""
                        echo "=========================================="
                        echo "SERVICE.YML"
                        echo "=========================================="

                        kubectl apply \
                            -f k8s/service.yml \
                            -n "${K8S_NAMESPACE}"

                        echo ""
                        echo "=========================================="
                        echo "INGRESS.YML"
                        echo "=========================================="

                        kubectl apply \
                            -f k8s/ingress.yml \
                            -n "${K8S_NAMESPACE}"

                        echo ""
                        echo "=========================================="
                        echo "KUBERNETES DEPLOYMENT COMPLETED"
                        echo "=========================================="

                        echo ""
                        echo "Deployment:"
                        echo "  k8s/deployment.yml"

                        echo ""
                        echo "Service:"
                        echo "  k8s/service.yml"

                        echo ""
                        echo "Ingress:"
                        echo "  k8s/ingress.yml"

                        echo ""
                        echo "ECR Image:"
                        echo "  ${ECR_IMAGE}"

                        echo ""
                        echo "EKS Cluster:"
                        echo "  ${EKS_CLUSTER_NAME}"

                        echo ""
                        echo "=========================================="
                    '''
                }
            }
        }
    }

    post {

        success {

            echo '=========================================='
            echo '          PIPELINE SUCCESSFUL'
            echo '=========================================='

            echo ''
            echo "Existing ECR image:"
            echo "${ECR_IMAGE}"

            echo ''
            echo "EKS cluster:"
            echo "${EKS_CLUSTER_NAME}"

            echo ''
            echo "Kubernetes resources:"
            echo "  deployment.yml"
            echo "  service.yml"
            echo "  ingress.yml"

            echo ''
            echo 'Application deployment completed successfully.'

            echo '=========================================='
        }


        failure {

            echo '=========================================='
            echo '            PIPELINE FAILED'
            echo '=========================================='

            echo ''
            echo 'Check the FIRST failed stage above.'
            echo ''

            echo '=========================================='
        }


        always {

            echo '=========================================='
            echo '       CLEANING TEMPORARY FILES'
            echo '=========================================='

            sh '''
                set +e

                rm -rf "${WORKSPACE}/.venv"
                rm -rf "${WORKSPACE}/.kube"
                rm -rf "${WORKSPACE}/.trivy-cache"
                rm -rf "${WORKSPACE}/.trivy-image-cache"

                echo ""
                echo "Cleanup completed."
            '''

            cleanWs()
        }
    }
}
